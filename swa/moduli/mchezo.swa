W0 mchezo_weka_teknolojia(Mchezo* g, TeknolojiaMfumo* v) { g->teknolojia_addr = v; }

MaarifaUtafiti* mchezo_pata_maarifa(Mchezo* g) { rudisha g->maarifa_addr; }
W0 mchezo_weka_maarifa(Mchezo* g, MaarifaUtafiti* v) { g->maarifa_addr = v; }

W0 mchezo_usanidi_chaguomsingi(MchezoUsanidi* u) {
    kama (u == 0) { rudisha; }
    u->jina = "Ustaarabu Mpya";
    u->toleo = "0.1.0";
    u->mwaka_wa_kuanza = 0 - 4000;
    u->ugumu = 1;
    u->washa_mantiki_isiyo_wazi = 1;
    u->washa_ufuatiliaji_wa_utegemezi = 1;
    u->muda_wa_hifadhi_otomatiki = 10;
    u->kiwango_cha_juu_cha_kumbukumbu_matukio = 500;
}

Mchezo* mchezo_unda() {
    Mchezo* g = tenga(ukubwa(Mchezo));
    g->hali_ya_mchezo = MCHEZO_HALI_KUANDAA;
    g->zamu_ya_sasa = 0;
    g->inafanya_kazi = 0;
    g->imesimamishwa = 0;
    g->muda_addr = 0;
    g->idadi_ya_watu_addr = 0;
    g->serikali_addr = 0;
    g->ramani_addr = 0;
    g->makazi_addr = 0;
    g->akili_addr = 0;
    g->diplomasia_addr = 0;
    g->taifa_addr = 0;
    g->uchumi_mkuu_addr = 0;
    g->nguvukazi_addr = 0;
    g->sera_addr = 0;
    g->kodi_addr = 0;
    g->bajeti_addr = 0;
    g->bidhaa_addr = 0;
    g->benki_addr = 0;
    g->kilimo_addr = 0;
    g->uchimbaji_addr = 0;
    g->miundombinu_addr = 0;
    g->viwanda_addr = 0;
    g->nishati_addr = 0;
    g->uchumi_makazi_addr = 0;
    g->ardhi_addr = 0;
    g->mtaji_addr = 0;
    g->biashara_ndani_addr = 0;
    g->biashara_nje_addr = 0;
    g->uvumbuzi_addr = 0;
    g->soko_haramu_addr = 0;
    g->vita_addr = 0;
    g->utamaduni_kitambulisho_addr = 0;
    g->utamaduni_kuenea_addr = 0;
    g->utamaduni_itikadi_addr = 0;
    g->utamaduni_uigaji_addr = 0;
    g->utamaduni_dini_addr = 0;
    g->matukio_addr = 0;
    g->wakala_addr = 0;
    g->injini_okestra_addr = 0;
    g->injini_saa_kuu_addr = 0;
    g->injini_uhifadhi_addr = 0;
    g->injini_utendaji_addr = 0;
    g->jeshi_vitengo_addr = 0;
    g->mapigano_addr = 0;
    g->ushindi_addr = 0;
    g->kikundi_addr = 0;
    g->teknolojia_addr = 0;
    g->maarifa_addr = 0;
    g->utendaji.idadi_ya_sasisho = 0;
    g->utendaji.muda_wa_wastani_wa_sasisho = 0.0;
    g->utendaji.muda_wa_mwisho_wa_sasisho = 0.0;
    rudisha g;
}

// mchezo_anzisha: uanzishaji ULIOPUNGUZWA (simplified) — huunda
// mifumo saba ya msingi tu (angalia maelezo ya wigo juu ya faili),
// SI mzunguko kamili wa civ_game_initialize (hauna upakiaji wa data
// ya nje, hauna mifumo 18 ya uchumi, hauna NPC engine seeding).
CivMatokeo mchezo_anzisha(Mchezo* g, MchezoUsanidi* usanidi) {
    CivMatokeo r;
    kama (g == 0 || usanidi == 0) {
        r.hitilafu = CIV_HITILAFU_KIELEKEZI_TUPU;
        r.ujumbe = "Mchezo au usanidi ni tupu";
        rudisha r;
    }

    g->usanidi.jina = usanidi->jina;
    g->usanidi.toleo = usanidi->toleo;
    g->usanidi.mwaka_wa_kuanza = usanidi->mwaka_wa_kuanza;
    g->usanidi.ugumu = usanidi->ugumu;
    g->usanidi.washa_mantiki_isiyo_wazi = usanidi->washa_mantiki_isiyo_wazi;
    g->usanidi.washa_ufuatiliaji_wa_utegemezi = usanidi->washa_ufuatiliaji_wa_utegemezi;
    g->usanidi.muda_wa_hifadhi_otomatiki = usanidi->muda_wa_hifadhi_otomatiki;
    g->usanidi.kiwango_cha_juu_cha_kumbukumbu_matukio = usanidi->kiwango_cha_juu_cha_kumbukumbu_matukio;

    mchezo_weka_muda(g, injini_muda_unda());
    mchezo_weka_idadi_ya_watu(g, idadi_ya_watu_unda());
    mchezo_weka_serikali(g, utawala_serikali_unda(usanidi->jina));
    // Ukubwa wa ramani: mfano wa 360x180 (shahada moja kwa kila
    // kipande) — angalia maelezo ya wigo juu ya faili kuhusu
    // earth_2048x1024.earth halisi ambayo bado haijaunganishwa hapa.
    mchezo_weka_ramani(g, dunia_ramani_unda(360, 180, 12345));
    mchezo_weka_makazi(g, dunia_makazi_msimamizi_unda());
    mchezo_weka_akili(g, akili_mfumo_unda());
    mchezo_weka_diplomasia(g, diplomasia_unda());

    // Taifa (nation.c): mfumo wa mataifa, yakidai eneo kutoka ramani
    // iliyokwisha undwa juu. Tunatumia njia ya data (anzisha_kutoka_data)
    // badala ya chaguo_msingi moja kwa moja: Mchezo bado hana DuniaMipakaKisiasa
    // wala DuniaMataifaData halisi (hazijawekwa bado kwenye mzunguko wa
    // mchezo), hivyo tunapitisha 0/0 -- kazi yenyewe tayari ina ukaguzi
    // sahihi (mipaka == 0 -> chaguo_msingi), hivyo tabia ya sasa ni sawa
    // na kabla. Ukiwa na mipaka ya kisiasa halisi baadaye, njia hii
    // itatumia data halisi bila mabadiliko zaidi hapa.
    TaifaMfumo* taifa = dunia_taifa_mfumo_unda();
    DuniaMataifaData* mataifa_data_bado_hakuna = 0;
    DuniaMipakaKisiasa* mipaka_kisiasa_bado_hakuna = 0;
    dunia_taifa_mfumo_anzisha_kutoka_data(taifa, mataifa_data_bado_hakuna, mipaka_kisiasa_bado_hakuna);
    mchezo_weka_taifa(g, taifa);
    DuniaRamani* ramani_kwa_taifa = mchezo_pata_ramani(g);
    kama (ramani_kwa_taifa != 0) {
        dunia_taifa_mfumo_dai_maeneo_yote(taifa, ramani_kwa_taifa);
    }

    // Nguzo ya uchumi (moduli 20) — hakuna upakiaji wa data ya
    // jiografia halisi bado, hivyo baadhi ya hoja za "jiografia"
    // (eneo la ardhi, utajiri wa madini, n.k.) zinatumia thamani za
    // kawaida (placeholder) zilizoelezwa hapa chini badala ya
    // kusomwa kutoka ramani halisi.
    mchezo_weka_uchumi_mkuu(g, uchumi_mkuu_unda());
    mchezo_weka_nguvukazi(g, nguvukazi_unda());
    mchezo_weka_sera(g, sera_unda());
    mchezo_weka_kodi(g, kodi_unda());
    mchezo_weka_bajeti(g, bajeti_unda());
    mchezo_weka_bidhaa(g, bidhaa_soko_unda());
    mchezo_weka_benki(g, benki_unda());
    mchezo_weka_kilimo(g, kilimo_unda());
    mchezo_weka_uchimbaji(g, uchimbaji_unda());
    mchezo_weka_miundombinu(g, miundombinu_unda());
    mchezo_weka_viwanda(g, viwanda_unda());
    mchezo_weka_nishati(g, nishati_unda());
    mchezo_weka_uchumi_makazi(g, makazi_unda());
    // ardhi_unda inahitaji eneo la jumla la taifa (km2) — thamani ya
    // kawaida ya 500,000 km2 (takriban ukubwa wa taifa la kati)
    // hutumika hadi upakiaji wa data halisi ya jiografia uunganishwe.
    mchezo_weka_ardhi(g, ardhi_unda(500000.0));
    mchezo_weka_mtaji(g, mtaji_unda());
    mchezo_weka_biashara_ndani(g, biashara_ndani_unda());
    mchezo_weka_biashara_nje(g, biashara_nje_unda());
    mchezo_weka_uvumbuzi(g, uvumbuzi_unda());
    mchezo_weka_soko_haramu(g, soko_haramu_unda());
    mchezo_weka_vita(g, vita_unda());

    // Utamaduni (mifumo 5), matukio, wakala, injini_* — nyongeza ya
    // wimbi la tano. Mifumo yote inaundwa TUPU (hakuna vitambulisho/
    // itikadi/dini vya awali vilivyowekwa) — ni miundombinu tayari
    // kupokea data halisi ya kitamaduni pale itakapounganishwa.
    mchezo_weka_utamaduni_kitambulisho(g, utamaduni_kitambulisho_mfumo_unda());
    mchezo_weka_utamaduni_kuenea(g, utamaduni_kuenea_unda());
    mchezo_weka_utamaduni_itikadi(g, utamaduni_itikadi_mfumo_unda());
    mchezo_weka_utamaduni_uigaji(g, utamaduni_uigaji_tracker_unda());
    mchezo_weka_utamaduni_dini(g, utamaduni_dini_mfumo_unda());
    mchezo_weka_matukio(g, matukio_tukio_mfumo_unda());
    mchezo_weka_wakala(g, wakala_injini_unda());
    mchezo_weka_okestra(g, injini_okestra_unda());
    mchezo_weka_saa_kuu(g, injini_saa_unda());
    mchezo_weka_uhifadhi(g, injini_uhifadhi_unda("saves"));
    mchezo_weka_utendaji(g, injini_utendaji_unda());

    // Jeshi (units/combat/conquest), siasa_kikundi (factions),
    // teknolojia, maarifa (research) — nyongeza ya wimbi la tano,
    // sehemu ya pili.
    mchezo_weka_jeshi_vitengo(g, jeshi_vitengo_unda());
    mchezo_weka_mapigano(g, mapigano_mfumo_unda());
    mchezo_weka_ushindi(g, ushindi_mfumo_unda());

    // siasa_kikundi_mfumo_unda() na teknolojia_unda() zinarudisha
    // muundo KWA THAMANI (si kielekezi) — badala ya kujaribu
    // `*kielekezi = thamani;` (njia ambayo haijawahi kujaribiwa
    // kikao hiki kwa miundo hii mikubwa), tunatenga kwenye rundo na
    // kunakili field kwa field, mtindo ulioothibitishwa salama.
    SiasaKikundiMfumo kikundi_v = siasa_kikundi_mfumo_unda();
    SiasaKikundiMfumo* kikundi_p = tenga(ukubwa(SiasaKikundiMfumo));
    kikundi_p->vikundi = kikundi_v.vikundi;
    kikundi_p->idadi = kikundi_v.idadi;
    kikundi_p->uwezo = kikundi_v.uwezo;
    mchezo_weka_kikundi(g, kikundi_p);

    TeknolojiaMfumo tek_v = teknolojia_unda();
    TeknolojiaMfumo* tek_p = tenga(ukubwa(TeknolojiaMfumo));
    tek_p->bajeti_jumla = tek_v.bajeti_jumla;
    tek_p->kiwango = tek_v.kiwango;
    tek_p->cheo_duniani = tek_v.cheo_duniani;
    tek_p->wastani_duniani = tek_v.wastani_duniani;
    tek_p->kiwango_jumla = tek_v.kiwango_jumla;
    tek_p->cheo_jumla = tek_v.cheo_jumla;
    tek_p->mgao_0 = tek_v.mgao_0; tek_p->mgao_1 = tek_v.mgao_1;
    tek_p->mgao_2 = tek_v.mgao_2; tek_p->mgao_3 = tek_v.mgao_3;
    tek_p->mgao_4 = tek_v.mgao_4; tek_p->mgao_5 = tek_v.mgao_5;
    tek_p->mgao_6 = tek_v.mgao_6; tek_p->mgao_7 = tek_v.mgao_7;
    tek_p->mgao_8 = tek_v.mgao_8; tek_p->mgao_9 = tek_v.mgao_9;
    tek_p->mgao_10 = tek_v.mgao_10; tek_p->mgao_11 = tek_v.mgao_11;
    tek_p->kasi_0 = tek_v.kasi_0; tek_p->kasi_1 = tek_v.kasi_1;
    tek_p->kasi_2 = tek_v.kasi_2; tek_p->kasi_3 = tek_v.kasi_3;
    tek_p->kasi_4 = tek_v.kasi_4; tek_p->kasi_5 = tek_v.kasi_5;
    tek_p->kasi_6 = tek_v.kasi_6; tek_p->kasi_7 = tek_v.kasi_7;
    tek_p->kasi_8 = tek_v.kasi_8; tek_p->kasi_9 = tek_v.kasi_9;
    tek_p->kasi_10 = tek_v.kasi_10; tek_p->kasi_11 = tek_v.kasi_11;
    mchezo_weka_teknolojia(g, tek_p);

    mchezo_weka_maarifa(g, maarifa_unda());

    g->hali_ya_mchezo = MCHEZO_HALI_INAENDESHA;
    g->inafanya_kazi = 1;
    g->imesimamishwa = 0;
    g->zamu_ya_sasa = 1;

    andika("[MCHEZO] Umeanzishwa kwenye zamu %d\n", g->zamu_ya_sasa, 0,0,0,0,0);

    r.hitilafu = CIV_SAWA;
    r.ujumbe = 0;
    rudisha r;
}

// mchezo_sasisha: mzunguko mmoja wa sasisha ULIOPUNGUZWA — hupitisha
// mifumo saba iliyounganishwa tu, kwa mpangilio wa kimantiki
// (wakati -> idadi ya watu -> utawala -> makazi -> akili -> diplomasia).
// SI civ_game_update kamili (haina uchumi, hauna mizunguko ya
// mfululizo ya awamu 10 za asili).
W0 mchezo_sasisha(Mchezo* g) {
    kama (g == 0 || g->inafanya_kazi == 0 || g->imesimamishwa != 0) { rudisha; }

    D64 dt = 1.0;
    InjiniMudaMfumo* muda = mchezo_pata_muda(g);
    kama (muda != 0) {
        dt = injini_muda_sasisha(muda, 1.0);
        kama (dt <= 0.0) { dt = 1.0; }
    }

    IdadiYaWatuMsimamizi* pm = mchezo_pata_idadi_ya_watu(g);
    N32 idadi_ya_watu_n = 100;
    kama (pm != 0) {
        idadi_ya_watu_sasisha(pm, dt, 0.5);
        N64 idadi_jumla = pm->demografia.idadi_jumla;
        idadi_ya_watu_n = idadi_jumla;
        kama (idadi_ya_watu_n < 100) { idadi_ya_watu_n = 100; }
    }

    // Nguzo ya uchumi (moduli 20) — mpangilio wa awamu unafuata
    // civ_game_update ya asili (Awamu 1a-1s): macro -> nguvukazi ->
    // sera -> kodi -> bajeti -> bidhaa -> benki -> kilimo ->
    // uchimbaji -> miundombinu -> viwanda -> nishati -> makazi ->
    // ardhi -> mtaji -> biashara_ndani -> biashara_nje -> uvumbuzi ->
    // soko_haramu -> vita. Kila kimoja hulishwa na matokeo halisi ya
    // kile kilichotangulia pale inapowezekana (GDP, mfumuko, rushwa,
    // riba, ubora wa miundombinu, n.k.) badala ya thamani za bandia.
    D64 pato = 0.0;
    D64 mfumuko = 0.02;
    D64 ukuaji = 0.0;
    D64 ukosefu_wa_kazi = 0.05;
    D64 rushwa_jumla = 0.0;
    D64 ufanisi_wa_utawala = 0.5;

    UtawalaSerikali* serikali_kwa_uchumi = mchezo_pata_serikali(g);
    kama (serikali_kwa_uchumi != 0) {
        rushwa_jumla = utawala_serikali_pata_rushwa_jumla(serikali_kwa_uchumi);
        ufanisi_wa_utawala = serikali_kwa_uchumi->ufanisi;
    }

    UchumiMkuuMfumo* mkuu = mchezo_pata_uchumi_mkuu(g);
    kama (mkuu != 0) {
        UchumiMkuuRipoti ripoti = uchumi_mkuu_sasisha(mkuu, dt, idadi_ya_watu_n, 5000.0, 0.5);
        pato = ripoti.pato_la_taifa;
        mfumuko = ripoti.kiwango_cha_mfumuko;
        ukuaji = ripoti.kiwango_cha_ukuaji;
        ukosefu_wa_kazi = ripoti.kiwango_cha_ukosefu_wa_kazi;
    }

    NguvukaziMfumo* nguvukazi = mchezo_pata_nguvukazi(g);
    D64 mshahara_wa_wastani = 30000.0;
    kama (nguvukazi != 0) {
        NguvukaziMazingira* nm = tenga(ukubwa(NguvukaziMazingira));
        nm->kiwango_cha_teknolojia = 0.5;
        nm->kiwango_cha_elimu = 0.5;
        nm->imani_ya_biashara = 0.6;
        nguvukazi_sasisha(nguvukazi, dt, idadi_ya_watu_n, pato, nm);
        achilia nm;
        mshahara_wa_wastani = nguvukazi->mshahara_wa_wastani_wa_taifa;
    }

    SeraMfumo* sera = mchezo_pata_sera(g);
    kama (sera != 0) {
        sera_sasisha(sera, dt, mfumuko, ukosefu_wa_kazi, ukuaji, rushwa_jumla);
    }

    KodiMfumo* kodi = mchezo_pata_kodi(g);
    D64 mapato_ya_kodi = 0.0;
    kama (kodi != 0) {
        kodi_sasisha(kodi, dt, pato, idadi_ya_watu_n, ufanisi_wa_utawala, rushwa_jumla);
        mapato_ya_kodi = kodi->mapato_jumla;
    }

    BajetiMfumo* bajeti = mchezo_pata_bajeti(g);
    D64 mgao_wa_miundombinu = 1000.0;
    kama (bajeti != 0) {
        bajeti_sasisha(bajeti, dt, mapato_ya_kodi, pato);
        mgao_wa_miundombinu = bajeti_pata_mgao(bajeti, 0);
    }

    BidhaaSoko* bidhaa = mchezo_pata_bidhaa(g);
    kama (bidhaa != 0) {
        bidhaa_soko_sasisha_zote(bidhaa);
    }

    BenkiMfumo* benki = mchezo_pata_benki(g);
    D64 kiwango_cha_riba = 0.04;
    kama (benki != 0) {
        benki_sasisha(benki, dt, mfumuko, ukuaji, ukosefu_wa_kazi, 0.3);
        kiwango_cha_riba = benki->kiwango_cha_msingi_cha_riba;
    }

    KilimoMfumo* kilimo = mchezo_pata_kilimo(g);
    kama (kilimo != 0) {
        kilimo_sasisha(kilimo, dt, idadi_ya_watu_n, 5000.0, 0.5, 1.0);
    }

    UchimbajiMfumo* uchimbaji = mchezo_pata_uchimbaji(g);
    kama (uchimbaji != 0) {
        uchimbaji_sasisha(uchimbaji, dt, 0.5, mshahara_wa_wastani, 0.5);
    }

    MiundombinuMfumo* miundombinu = mchezo_pata_miundombinu(g);
    D64 ubora_wa_miundombinu = 0.5;
    kama (miundombinu != 0) {
        miundombinu_sasisha(miundombinu, dt, mgao_wa_miundombinu, idadi_ya_watu_n, 1.0);
        ubora_wa_miundombinu = miundombinu->ubora_wa_jumla;
    }

    ViwandaMfumo* viwanda = mchezo_pata_viwanda(g);
    D64 pato_la_viwanda = 0.0;
    kama (viwanda != 0) {
        viwanda_sasisha(viwanda, dt, 0.5, mshahara_wa_wastani, 0.5, ubora_wa_miundombinu);
        pato_la_viwanda = viwanda->pato_jumla_la_viwanda;
    }

    NishatiMfumo* nishati = mchezo_pata_nishati(g);
    kama (nishati != 0) {
        nishati_sasisha(nishati, dt, idadi_ya_watu_n, pato_la_viwanda, 0.5, 0.7);
    }

    MakaziMfumo* uchumi_makazi = mchezo_pata_uchumi_makazi(g);
    kama (uchumi_makazi != 0) {
        makazi_sasisha(uchumi_makazi, dt, idadi_ya_watu_n, mshahara_wa_wastani, kiwango_cha_riba, 1.0);
    }

    ArdhiMfumo* ardhi = mchezo_pata_ardhi(g);
    D64 pato_kwa_mtu = 0.0;
    kama (ardhi != 0) {
        N32 idadi_ya_watu_p1 = idadi_ya_watu_n + 1;
        D64 idadi_ya_watu_p1_d = idadi_ya_watu_p1;
        pato_kwa_mtu = pato / idadi_ya_watu_p1_d;
        ardhi_sasisha(ardhi, dt, idadi_ya_watu_n, pato_kwa_mtu, 0.02);
    }

    MtajiMfumo* mtaji = mchezo_pata_mtaji(g);
    kama (mtaji != 0) {
        mtaji_sasisha(mtaji, dt, pato, 0.2, kiwango_cha_riba, 0.6);
    }

    BiasharaNdaniMfumo* biashara_ndani = mchezo_pata_biashara_ndani(g);
    kama (biashara_ndani != 0) {
        biashara_ndani_sasisha(biashara_ndani, dt, ubora_wa_miundombinu, idadi_ya_watu_n, 1.0);
    }

    BiasharaNjeMfumo* biashara_nje = mchezo_pata_biashara_nje(g);
    kama (biashara_nje != 0) {
        biashara_nje_sasisha(biashara_nje, dt);
    }

    UvumbuziMfumo* uvumbuzi = mchezo_pata_uvumbuzi(g);
    kama (uvumbuzi != 0) {
        UvumbuziMazingira* um = tenga(ukubwa(UvumbuziMazingira));
        um->elimu = 0.5;
        um->imani_ya_biashara = 0.6;
        um->kiwango_cha_kanuni = 0.4;
        um->upatikanaji_wa_mtaji = 0.5;
        uvumbuzi_sasisha(uvumbuzi, dt, pato, um);
        achilia um;
    }

    SokoHaramuMfumo* soko_haramu = mchezo_pata_soko_haramu(g);
    kama (soko_haramu != 0) {
        SokoHaramuMazingira* sm = tenga(ukubwa(SokoHaramuMazingira));
        sm->kiwango_cha_rushwa = rushwa_jumla;
        sm->kiwango_cha_ukosefu_wa_kazi = ukosefu_wa_kazi;
        sm->kiwango_cha_kanuni = 0.4;
        sm->bajeti_ya_udhibiti = mgao_wa_miundombinu;
        soko_haramu_sasisha(soko_haramu, dt, pato, sm);
        achilia sm;
    }

    VitaMfumo* vita = mchezo_pata_vita(g);
    kama (vita != 0) {
        vita_sasisha(vita, dt, pato, pato_la_viwanda, idadi_ya_watu_n, 0);
    }

    TaifaMfumo* taifa = mchezo_pata_taifa(g);
    DuniaRamani* ramani_kwa_uchumi = mchezo_pata_ramani(g);
    kama (taifa != 0 && ramani_kwa_uchumi != 0) {
        DuniaRasilimaliRamani* rm_tupu = 0;
        TaifaUchumi* jumla_tupu = 0;
        dunia_taifa_hesabu_uchumi_wote(taifa, ramani_kwa_uchumi, rm_tupu, jumla_tupu);
    }

    UtawalaSerikali* serikali = mchezo_pata_serikali(g);
    kama (serikali != 0) {
        utawala_serikali_sasisha(serikali, dt, idadi_ya_watu_n, 0.5, pato);
    }

    DuniaRamani* ramani = mchezo_pata_ramani(g);
    DuniaMakaziMsimamizi* makazi = mchezo_pata_makazi(g);
    kama (makazi != 0 && ramani != 0) {
        dunia_makazi_msimamizi_sasisha(makazi, ramani, dt);
    }

    AkiliMfumo* akili = mchezo_pata_akili(g);
    kama (akili != 0) {
        akili_mfumo_sasisha(akili, dt);
    }

    DiplomasiaMfumo* diplomasia = mchezo_pata_diplomasia(g);
    kama (diplomasia != 0) {
        N64 zamu_d = g->zamu_ya_sasa;
        diplomasia_sasisha_mahusiano(diplomasia, zamu_d);
    }

    // Utamaduni: kuenea na uigaji vyote hufanya kazi juu ya mfumo
    // mzima wa vitambulisho (kitambulisho_addr) -- itikadi/dini
    // hazina kazi ya "sasisha zote" ya kiwango cha mfumo (zinaundwa
    // tayari kupokea vitu vya kibinafsi baadaye), kwa hiyo hazipigi
    // simu hapa (kupiga simu kwenye mfumo tupu kusingekuwa na athari
    // yoyote).
    UtamaduniKitambulishoMfumo* kitambulisho_mfumo = mchezo_pata_utamaduni_kitambulisho(g);
    UtamaduniKuenea* kuenea = mchezo_pata_utamaduni_kuenea(g);
    kama (kuenea != 0 && kitambulisho_mfumo != 0) {
        utamaduni_kuenea_chakata(kuenea, kitambulisho_mfumo, dt);
    }
    UtamaduniUigajiTracker* uigaji = mchezo_pata_utamaduni_uigaji(g);
    kama (uigaji != 0 && kitambulisho_mfumo != 0) {
        utamaduni_uigaji_tracker_sasisha(uigaji, kitambulisho_mfumo, dt);
    }

    MatukioTukioMfumo* matukio = mchezo_pata_matukio(g);
    kama (matukio != 0) {
        matukio_tukio_sasisha(matukio, dt);
    }

    // Jeshi (units/combat) hazina "sasisha zote" ya kiwango cha
    // mfumo — mapigano ni ya tukio (event-driven, simulisha vita
    // moja mahususi), vitengo ni ya kitendo (ajiri/imarisha kwa
    // ombi) — zote mbili ni sahihi kubaki bila wito hapa, ni
    // kwa makusudi, si pengo.
    UshindiMfumo* ushindi = mchezo_pata_ushindi(g);
    kama (ushindi != 0) {
        ushindi_sasisha(ushindi, dt);
    }

    SiasaKikundiMfumo* kikundi = mchezo_pata_kikundi(g);
    kama (kikundi != 0) {
        siasa_kikundi_mfumo_sasisha(kikundi, dt);
    }

    TeknolojiaMfumo* teknolojia = mchezo_pata_teknolojia(g);
    kama (teknolojia != 0) {
        teknolojia_sasisha(teknolojia, dt);
    }

    MaarifaUtafiti* maarifa = mchezo_pata_maarifa(g);
    kama (maarifa != 0) {
        maarifa_sasisha(maarifa, idadi_ya_watu_n, 1);
    }

    g->utendaji.idadi_ya_sasisho = g->utendaji.idadi_ya_sasisho + 1;
}

CivMatokeo mchezo_maliza_zamu(Mchezo* g) {
    CivMatokeo r;
    kama (g == 0) {
        r.hitilafu = CIV_HITILAFU_KIELEKEZI_TUPU;
        r.ujumbe = "Mchezo ni tupu";
        rudisha r;
    }
    g->zamu_ya_sasa = g->zamu_ya_sasa + 1;

    // Saa kuu (mwaka/siku) na wakala (maamuzi ya NPC) ni HALISI YA
    // ZAMU (per-turn), si ya kila mzunguko wa dt kama mchezo_sasisha
    // -- huitwa hapa, si kwenye mchezo_sasisha.
    InjiniSaaKuu* saa = mchezo_pata_saa_kuu(g);
    kama (saa != 0) { injini_saa_songesha_zamu(saa); }

    WakalaInjini* wakala = mchezo_pata_wakala(g);
    kama (wakala != 0 && saa != 0) {
        wakala_injini_sasisha_zamu(wakala, saa->mwaka_wa_ulimwengu, saa->siku_ya_ulimwengu);
    }

    andika("[MCHEZO] Zamu imekamilika, zamu mpya: %d\n", g->zamu_ya_sasa, 0,0,0,0,0);
    r.hitilafu = CIV_SAWA;
    r.ujumbe = 0;
    rudisha r;
}

W0 mchezo_pumzisha(Mchezo* g) {
    kama (g != 0) { g->imesimamishwa = 1; }
}

W0 mchezo_endelea(Mchezo* g) {
    kama (g != 0) { g->imesimamishwa = 0; }
}

W0 mchezo_zima(Mchezo* g) {
    kama (g == 0) { rudisha; }
    g->inafanya_kazi = 0;
    g->hali_ya_mchezo = MCHEZO_HALI_INAZIMWA;

    InjiniMudaMfumo* muda = mchezo_pata_muda(g);
    kama (muda != 0) { injini_muda_uharibu(muda); }
    IdadiYaWatuMsimamizi* pm = mchezo_pata_idadi_ya_watu(g);
    kama (pm != 0) { idadi_ya_watu_uharibu(pm); }
    UtawalaSerikali* serikali = mchezo_pata_serikali(g);
    kama (serikali != 0) { utawala_serikali_uharibu(serikali); }
    DuniaMakaziMsimamizi* makazi = mchezo_pata_makazi(g);
    kama (makazi != 0) { dunia_makazi_msimamizi_uharibu(makazi); }
    DuniaRamani* ramani = mchezo_pata_ramani(g);
    kama (ramani != 0) { dunia_ramani_uharibu(ramani); }
    AkiliMfumo* akili = mchezo_pata_akili(g);
    kama (akili != 0) { akili_mfumo_uharibu(akili); }
    DiplomasiaMfumo* diplomasia = mchezo_pata_diplomasia(g);
    kama (diplomasia != 0) { diplomasia_uharibu(diplomasia); }

    TaifaMfumo* taifa = mchezo_pata_taifa(g);
    kama (taifa != 0) { dunia_taifa_mfumo_uharibu(taifa); }
    UchumiMkuuMfumo* mkuu = mchezo_pata_uchumi_mkuu(g);
    kama (mkuu != 0) { uchumi_mkuu_uharibu(mkuu); }
    NguvukaziMfumo* nguvukazi = mchezo_pata_nguvukazi(g);
    kama (nguvukazi != 0) { nguvukazi_uharibu(nguvukazi); }
    SeraMfumo* sera = mchezo_pata_sera(g);
    kama (sera != 0) { sera_uharibu(sera); }
    KodiMfumo* kodi = mchezo_pata_kodi(g);
    kama (kodi != 0) { kodi_uharibu(kodi); }
    BajetiMfumo* bajeti = mchezo_pata_bajeti(g);
    kama (bajeti != 0) { bajeti_uharibu(bajeti); }
    BidhaaSoko* bidhaa = mchezo_pata_bidhaa(g);
    kama (bidhaa != 0) { bidhaa_soko_uharibu(bidhaa); }
    BenkiMfumo* benki = mchezo_pata_benki(g);
    kama (benki != 0) { benki_uharibu(benki); }
    KilimoMfumo* kilimo = mchezo_pata_kilimo(g);
    kama (kilimo != 0) { kilimo_uharibu(kilimo); }
    UchimbajiMfumo* uchimbaji = mchezo_pata_uchimbaji(g);
    kama (uchimbaji != 0) { uchimbaji_uharibu(uchimbaji); }
    MiundombinuMfumo* miundombinu = mchezo_pata_miundombinu(g);
    kama (miundombinu != 0) { miundombinu_uharibu(miundombinu); }
    ViwandaMfumo* viwanda = mchezo_pata_viwanda(g);
    kama (viwanda != 0) { viwanda_uharibu(viwanda); }
    NishatiMfumo* nishati = mchezo_pata_nishati(g);
    kama (nishati != 0) { nishati_uharibu(nishati); }
    MakaziMfumo* uchumi_makazi = mchezo_pata_uchumi_makazi(g);
    kama (uchumi_makazi != 0) { makazi_uharibu(uchumi_makazi); }
    ArdhiMfumo* ardhi = mchezo_pata_ardhi(g);
    kama (ardhi != 0) { ardhi_uharibu(ardhi); }
    MtajiMfumo* mtaji = mchezo_pata_mtaji(g);
    kama (mtaji != 0) { mtaji_uharibu(mtaji); }
    BiasharaNdaniMfumo* biashara_ndani = mchezo_pata_biashara_ndani(g);
    kama (biashara_ndani != 0) { biashara_ndani_uharibu(biashara_ndani); }
    BiasharaNjeMfumo* biashara_nje = mchezo_pata_biashara_nje(g);
    kama (biashara_nje != 0) { biashara_nje_uharibu(biashara_nje); }
    UvumbuziMfumo* uvumbuzi = mchezo_pata_uvumbuzi(g);
    kama (uvumbuzi != 0) { uvumbuzi_uharibu(uvumbuzi); }
    SokoHaramuMfumo* soko_haramu = mchezo_pata_soko_haramu(g);
    kama (soko_haramu != 0) { soko_haramu_uharibu(soko_haramu); }
    VitaMfumo* vita = mchezo_pata_vita(g);
    kama (vita != 0) { vita_uharibu(vita); }

    // Mifumo 5 ya utamaduni (kitambulisho, kuenea, itikadi, uigaji,
    // dini) HAIKUUHARIBIWA hapa KWA MAKUSUDI -- hakuna hata mmoja
    // wao anayetoa kazi ya "_uharibu"/"_mfumo_uharibu" (imethibitishwa
    // kwa kusoma faili zao halisi) -- ni pengo lililopo tayari kwenye
    // moduli hizo tano zenyewe, si kosa jipya la mchezo.swa.
    MatukioTukioMfumo* matukio_zima = mchezo_pata_matukio(g);
    kama (matukio_zima != 0) { matukio_tukio_mfumo_uharibu(matukio_zima); }
    WakalaInjini* wakala_zima = mchezo_pata_wakala(g);
    kama (wakala_zima != 0) { wakala_injini_uharibu(wakala_zima); }
    InjiniOkestra* okestra_zima = mchezo_pata_okestra(g);
    kama (okestra_zima != 0) { injini_okestra_uharibu(okestra_zima); }
    InjiniSaaKuu* saa_zima = mchezo_pata_saa_kuu(g);
    kama (saa_zima != 0) { injini_saa_uharibu(saa_zima); }
    InjiniUhifadhi* uhifadhi_zima = mchezo_pata_uhifadhi(g);
    kama (uhifadhi_zima != 0) { injini_uhifadhi_uharibu(uhifadhi_zima); }
    InjiniUtendaji* utendaji_zima = mchezo_pata_utendaji(g);
    kama (utendaji_zima != 0) { injini_utendaji_uharibu(utendaji_zima); }

    JeshiVitengoMfumo* jeshi_vitengo = mchezo_pata_jeshi_vitengo(g);
    kama (jeshi_vitengo != 0) { jeshi_vitengo_uharibu(jeshi_vitengo); }
    MapiganoMfumo* mapigano = mchezo_pata_mapigano(g);
    kama (mapigano != 0) { mapigano_mfumo_uharibu(mapigano); }
    UshindiMfumo* ushindi_zima = mchezo_pata_ushindi(g);
    kama (ushindi_zima != 0) { ushindi_mfumo_uharibu(ushindi_zima); }
    SiasaKikundiMfumo* kikundi_zima = mchezo_pata_kikundi(g);
    kama (kikundi_zima != 0) { siasa_kikundi_mfumo_uharibu(kikundi_zima); }
    TeknolojiaMfumo* teknolojia_zima = mchezo_pata_teknolojia(g);
    kama (teknolojia_zima != 0) { teknolojia_uharibu(teknolojia_zima); }
    MaarifaUtafiti* maarifa_zima = mchezo_pata_maarifa(g);
    kama (maarifa_zima != 0) { maarifa_uharibu(maarifa_zima); }
}

W0 mchezo_uharibu(Mchezo* g) {
    kama (g == 0) { rudisha; }
    mchezo_zima(g);
    achilia g;
}

// ---------------------------------------------------------------
// Uhifadhi/upakiaji wa hali ya mchezo (state_persistence.c) —
// tafsiri ya kwanza HALISI (si tu injini_uhifadhi iliyopo tayari
// kama sehemu isiyotumika).
//
// WIGO WA KIMAKUSUDI: injini_uhifadhi_hifadhi/pakia (uhifadhi.swa)
// ni primitives za baiti ghafi tu (andika/soma bafa+ukubwa) -- si
// serializer halisi. MchezoHifadhiData hapa chini ni muundo BAPA
// (hakuna vielekezi, hakuna miundo iliyowekwa ndani, hakuna
// safu/array) unaohifadhiwa/kupakiwa KAMA BAITI GHAFI moja kwa
// moja -- hii inaepuka mapungufu matatu yaliyothibitishwa kikao
// hiki: #186 (field ya kielekezi cha muundo ndani ya muundo
// haihifadhi sahihi), hakuna umbizaji wa D64/float ndani ya
// mfuatano_umbiza (hivyo maandishi/text serialization ya nambari
// za desimali haiwezekani sasa), na kuepuka safu zenye ukubwa
// maalum ndani ya muundo (haziwezi kuchanganuliwa).
//
// Tumeamua KUHIFADHI/KUPAKIA SHAMBA HALISI ZENYE "pata"/"weka"
// zilizothibitishwa TU -- si ripoti zilizotokana (derived reports)
// ambazo hazina njia ya kurudishwa kwenye hali hai (mfano: UchumiMkuuRipoti
// ni matokeo ya hesabu, si hali ghafi -- soko->kiwango_cha_kodi na
// soko->matumizi_ya_serikali ndizo pekee zenye "weka" kwenye
// uchumi_mkuu.swa). Hii inaruhusu jaribio la round-trip HALISI:
// unda -> badilisha -> hifadhi -> pakia kwenye kitu kipya -> linganisha
// shamba kwa shamba -- si tu "haikuanguka".
//
// Mifumo mingine (idadi ya watu, ramani, taifa, jeshi, n.k.) BADO
// HAIJAJUMUISHWA kwenye uhifadhi -- ni pengo linalojulikana wazi,
// si kosa la bahati mbaya. Kupanua MchezoHifadhiData kwa mifumo
// zaidi ni kazi ijayo, si sehemu ya toleo hili la kwanza.
muundo MchezoHifadhiData {
    N32 hali_ya_mchezo;
    N32 zamu_ya_sasa;
    N32 inafanya_kazi;
    N32 imesimamishwa;

    N32 usanidi_mwaka_wa_kuanza;
    N32 usanidi_ugumu;
    N32 usanidi_washa_mantiki_isiyo_wazi;
    N32 usanidi_washa_ufuatiliaji_wa_utegemezi;
    N32 usanidi_muda_wa_hifadhi_otomatiki;
    N32 usanidi_kiwango_cha_juu_cha_kumbukumbu_matukio;

    D64 uchumi_mkuu_kiwango_cha_kodi;
    D64 uchumi_mkuu_matumizi_ya_serikali;
};

N8* mchezo_hifadhi_data_kama_baiti(MchezoHifadhiData* d) { rudisha d; }
MchezoHifadhiData* mchezo_hifadhi_data_kutoka_baiti(N8* b) { rudisha b; }

W0 mchezo_hifadhi_data_jaza(Mchezo* g, MchezoHifadhiData* d) {
    d->hali_ya_mchezo = g->hali_ya_mchezo;
    d->zamu_ya_sasa = g->zamu_ya_sasa;
    d->inafanya_kazi = g->inafanya_kazi;
    d->imesimamishwa = g->imesimamishwa;

    d->usanidi_mwaka_wa_kuanza = g->usanidi.mwaka_wa_kuanza;
    d->usanidi_ugumu = g->usanidi.ugumu;
    d->usanidi_washa_mantiki_isiyo_wazi = g->usanidi.washa_mantiki_isiyo_wazi;
    d->usanidi_washa_ufuatiliaji_wa_utegemezi = g->usanidi.washa_ufuatiliaji_wa_utegemezi;
    d->usanidi_muda_wa_hifadhi_otomatiki = g->usanidi.muda_wa_hifadhi_otomatiki;
    d->usanidi_kiwango_cha_juu_cha_kumbukumbu_matukio = g->usanidi.kiwango_cha_juu_cha_kumbukumbu_matukio;

    UchumiMkuuMfumo* uchumi = mchezo_pata_uchumi_mkuu(g);
    kama (uchumi != 0) {
        d->uchumi_mkuu_kiwango_cha_kodi = uchumi->kiwango_cha_kodi;
        d->uchumi_mkuu_matumizi_ya_serikali = uchumi->matumizi_ya_serikali;
    }
}

W0 mchezo_hifadhi_data_tumia(Mchezo* g, MchezoHifadhiData* d) {
    g->hali_ya_mchezo = d->hali_ya_mchezo;
    g->zamu_ya_sasa = d->zamu_ya_sasa;
    g->inafanya_kazi = d->inafanya_kazi;
    g->imesimamishwa = d->imesimamishwa;

    g->usanidi.mwaka_wa_kuanza = d->usanidi_mwaka_wa_kuanza;
    g->usanidi.ugumu = d->usanidi_ugumu;
    g->usanidi.washa_mantiki_isiyo_wazi = d->usanidi_washa_mantiki_isiyo_wazi;
    g->usanidi.washa_ufuatiliaji_wa_utegemezi = d->usanidi_washa_ufuatiliaji_wa_utegemezi;
    g->usanidi.muda_wa_hifadhi_otomatiki = d->usanidi_muda_wa_hifadhi_otomatiki;
    g->usanidi.kiwango_cha_juu_cha_kumbukumbu_matukio = d->usanidi_kiwango_cha_juu_cha_kumbukumbu_matukio;

    UchumiMkuuMfumo* uchumi = mchezo_pata_uchumi_mkuu(g);
    kama (uchumi != 0) {
        uchumi_mkuu_weka_kiwango_cha_kodi(uchumi, d->uchumi_mkuu_kiwango_cha_kodi);
        uchumi_mkuu_weka_matumizi_ya_serikali(uchumi, d->uchumi_mkuu_matumizi_ya_serikali);
    }
}

// Huhifadhi hali ya sasa ya g kwenye jina_la_faili (ndani ya saraka
// ya injini_uhifadhi ya g, mfano "saves/jina_la_faili").
CivMatokeo mchezo_hifadhi(Mchezo* g, N8* jina_la_faili) {
    CivMatokeo r;
    r.hitilafu = CIV_SAWA;
    r.ujumbe = 0;
    kama (g == 0 || jina_la_faili == 0) {
        r.hitilafu = CIV_HITILAFU_KIELEKEZI_TUPU;
        r.ujumbe = "Mchezo au jina la faili ni tupu";
        rudisha r;
    }
    InjiniUhifadhi* sp = mchezo_pata_uhifadhi(g);
    kama (sp == 0) {
        r.hitilafu = CIV_HITILAFU_HALI_MBAYA;
        r.ujumbe = "Injini ya uhifadhi haijaanzishwa";
        rudisha r;
    }

    MchezoHifadhiData* d = tenga(ukubwa(MchezoHifadhiData));
    mchezo_hifadhi_data_jaza(g, d);
    N8* baiti = mchezo_hifadhi_data_kama_baiti(d);
    r = injini_uhifadhi_hifadhi(sp, jina_la_faili, baiti, ukubwa(MchezoHifadhiData));
    achilia d;
    rudisha r;
}

// Hupakia hali kutoka jina_la_faili na kuiweka moja kwa moja kwenye
// g (shamba na shamba, kupitia mchezo_hifadhi_data_tumia).
CivMatokeo mchezo_pakia(Mchezo* g, N8* jina_la_faili) {
    CivMatokeo r;
    r.hitilafu = CIV_SAWA;
    r.ujumbe = 0;
    kama (g == 0 || jina_la_faili == 0) {
        r.hitilafu = CIV_HITILAFU_KIELEKEZI_TUPU;
        r.ujumbe = "Mchezo au jina la faili ni tupu";
        rudisha r;
    }
    InjiniUhifadhi* sp = mchezo_pata_uhifadhi(g);
    kama (sp == 0) {
        r.hitilafu = CIV_HITILAFU_HALI_MBAYA;
        r.ujumbe = "Injini ya uhifadhi haijaanzishwa";
        rudisha r;
    }

    // MUHIMU: faili_soma_yote (msingi/maktaba/faili.swa) inahifadhi
    // baiti moja ya mwisho ya "uwezo" kwa ajili ya NUL (imeundwa kwa
    // ajili ya mfuatano wa maandishi) -- hivyo ikitolewa uwezo sawa
    // na ukubwa halisi wa data, itasoma baiti MOJA PUNGUFU kimya kimya
    // (imethibitishwa kwa jaribio: shamba la mwisho la D64 lilipotea
    // baiti yake ya mwisho). Tunatoa nafasi ya ziada ya baiti 1 ili
    // data yote ya MchezoHifadhiData isomwe kikamilifu.
    N64 uwezo_wa_kupakia = ukubwa(MchezoHifadhiData) + 1;
    N8* baiti = tenga(uwezo_wa_kupakia);
    r = injini_uhifadhi_pakia(sp, jina_la_faili, baiti, uwezo_wa_kupakia);
    kama (r.hitilafu != CIV_SAWA) {
        achilia baiti;
        rudisha r;
    }
    MchezoHifadhiData* d = mchezo_hifadhi_data_kutoka_baiti(baiti);
    mchezo_hifadhi_data_tumia(g, d);
    achilia baiti;
    rudisha r;
}
