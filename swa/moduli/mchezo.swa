// NYONGEZA (wimbi la kumi, 2026-10-03): moduli tano zilizotafsiriwa
// lakini ZISIZOUNGANISHWA kwenye vikao vilivyopita -- zilishikiliwa
// kimakusudi kwa sababu ya lugha-swa/swa#295 (ulinganishi kwenye hoja
// za wito ulikuwa ukichafua usajili wa hoja zilizofuata), si kwa
// uzembe. #295 sasa imerekebishwa (PR #297) -- zinaunganishwa hapa:
// vipimo_laini (abstracts/soft_metrics.c -- furaha/uhalali/fahari ya
// taifa, inalishwa na pato_kwa_mtu/ukosefu_wa_kazi HALISI kutoka
// uchumi_mkuu), kitengo_chini (subunits/subunit.c -- vitengo vidogo
// vya kiutawala, ina "sasisha zote"/dt halisi), uandishi
// (culture/writing_system.c -- mifumo ya uandishi, msimamizi
// anaundwa TUPU kama itikadi/dini -- hauna "sasisha zote" kwenye
// chanzo asili), historia_db (data/history_db.c -- journal ya
// matukio ya kihistoria, inaundwa na njia ya faili lakini
// HAIANDIKIWI tukio lolote kiotomatiki na mchezo_sasisha kwa sasa --
// miundombinu tayari kupokea matukio halisi baadaye, sawa na
// vilivyoandikwa kwa uandishi/kitambulisho), na soko_fedha
// (economy/financial_markets.c -- ubadilishanaji wa sarafu/bidhaa/
// makampuni, inalishwa na pato/chakula/nishati/viwanda HALISI kutoka
// nguzo ya uchumi kupitia soko_fedha_sasisha_uzalishaji).
husisha { moduli/abstracts/vipimo_laini.swa }
husisha { moduli/subunits/kitengo_chini.swa }
husisha { moduli/utamaduni/uandishi.swa }
husisha { moduli/data/historia_db.swa }
husisha { moduli/uchumi/soko_fedha.swa }

// NYONGEZA (wimbi la kumi na moja, 2026-10-03): mageuko_lugha
// (culture/language_evolution.c -- TAFSIRI MPYA, angalia maelezo
// ya field husika juu ya muundo Mchezo) na siasa (politics/politics.c
// -- mratibu wa uhalali/utulivu, angalia siasa.swa kwa maelezo
// kamili ya kwa nini HAIMILIKI nakala yake ya SiasaKikundiMfumo).
// utamaduni.swa (culture/culture.c) pia imehusishwa hapa -- kitanzi
// chake cha utamaduni_mfumo_sasisha_watambulisho_wote ndicho
// kinachoitwa (pengo halisi lililopatikana, angalia maelezo yake),
// si kazi yake ya "mfumo_sasisha" ya mfuatano kamili (ambayo
// ingeita tena kuenea/uigaji ambazo TAYARI zinaitwa moja kwa moja
// hapa chini kwenye mchezo_sasisha -- kuiita tena kungesababisha
// sasisho mara mbili kwa mzunguko mmoja).
husisha { moduli/utamaduni/mageuko_lugha.swa }
husisha { moduli/utamaduni/utamaduni.swa }
husisha { moduli/siasa/siasa.swa }

n32 MCHEZO_HALI_KUANDAA = 0;
n32 MCHEZO_HALI_INAENDESHA = 1;
n32 MCHEZO_HALI_IMESIMAMA = 2;
n32 MCHEZO_HALI_INAHIFADHI = 3;
n32 MCHEZO_HALI_INAPAKIA = 4;
n32 MCHEZO_HALI_INAZIMWA = 5;

muundo MchezoUsanidi {
    n8* jina;
    n8* toleo;
    n32 mwaka_wa_kuanza;
    n32 ugumu;
    n32 washa_mantiki_isiyo_wazi;
    n32 washa_ufuatiliaji_wa_utegemezi;
    n32 muda_wa_hifadhi_otomatiki;
    n32 kiwango_cha_juu_cha_kumbukumbu_matukio;
};

muundo MchezoUtendaji {
    n64 idadi_ya_sasisho;
    d64 muda_wa_wastani_wa_sasisho;
    d64 muda_wa_mwisho_wa_sasisho;
};

muundo Mchezo {
    n32 hali_ya_mchezo;
    MchezoUsanidi usanidi;
    MchezoUtendaji utendaji;

    n32 zamu_ya_sasa;
    n32 inafanya_kazi;
    n32 imesimamishwa;

    // Anwani za mifumo midogo (n64, si vielekezi vya moja kwa moja) —
    // lugha-swa/swa#186: field ya muundo yenye aina ya kielekezi
    // kwenda muundo mwingine haihifadhi thamani sahihi. Suluhisho
    // lililothibitishwa mara nyingi kikao hiki: hifadhi anwani kama
    // n64, tumia kazi ya "pata"/"weka" inayofanya ubadilishaji wa
    // aina (type coercion) kupitia aina ya kurudisha.
    n64 muda_addr;
    n64 idadi_ya_watu_addr;
    n64 serikali_addr;
    n64 ramani_addr;
    n64 makazi_addr;
    n64 akili_addr;
    n64 diplomasia_addr;

    // Taifa (nation.c) na nguzo ya uchumi (moduli 20) — kiambishi
    // "uchumi_makazi" kwa nyumba (housing) ili kuepuka mgongano na
    // "makazi_addr" ya juu (settlement_manager) ndani ya muundo huu.
    n64 taifa_addr;
    n64 uchumi_mkuu_addr;
    n64 nguvukazi_addr;
    n64 sera_addr;
    n64 kodi_addr;
    n64 bajeti_addr;
    n64 bidhaa_addr;
    n64 benki_addr;
    n64 kilimo_addr;
    n64 uchimbaji_addr;
    n64 miundombinu_addr;
    n64 viwanda_addr;
    n64 nishati_addr;
    n64 uchumi_makazi_addr;
    n64 ardhi_addr;
    n64 mtaji_addr;
    n64 biashara_ndani_addr;
    n64 biashara_nje_addr;
    n64 uvumbuzi_addr;
    n64 soko_haramu_addr;
    n64 vita_addr;

    // Nyongeza ya wimbi la tano: utamaduni, matukio, wakala, injini_*.
    n64 utamaduni_kitambulisho_addr;
    n64 utamaduni_kuenea_addr;
    n64 utamaduni_itikadi_addr;
    n64 utamaduni_uigaji_addr;
    n64 utamaduni_dini_addr;
    n64 matukio_addr;
    n64 wakala_addr;
    n64 injini_okestra_addr;
    n64 injini_saa_kuu_addr;
    n64 injini_uhifadhi_addr;
    n64 injini_utendaji_addr;

    // Nyongeza (wimbi la tano, sehemu ya pili): jeshi (units/combat/
    // conquest), siasa_kikundi (factions), teknolojia, maarifa
    // (research). `wakala` (NPC engine) ILIACHWA HAPA KWA MAKUSUDI —
    // tayari imeongezwa na kazi nyingine sambamba (angalia
    // wakala_addr juu) ili kuepuka mgongano wa marudio.
    n64 jeshi_vitengo_addr;
    n64 mapigano_addr;
    n64 ushindi_addr;
    n64 kikundi_addr;
    n64 teknolojia_addr;
    n64 maarifa_addr;

    // Nyongeza (wimbi la sita): mipaka_hai (dynamic borders), majanga
    // (disasters), eneo (territory) -- angalia maelezo ya wigo juu ya
    // faili.
    n64 mipaka_hai_addr;
    n64 majanga_addr;
    n64 eneo_addr;

    // Nyongeza (wimbi la saba): uhai (population vitality), sarafu
    // (currency), dunia_maajabu (world wonders), jamii (emergent
    // races), utawala_desturi (custom/emergent governance) -- angalia
    // maelezo ya wigo juu ya faili.
    n64 uhai_addr;
    n64 sarafu_addr;
    n64 maajabu_addr;
    n64 jamii_addr;
    n64 desturi_addr;

    // Nyongeza (wimbi la nane): utawala_mwingiliano (NPC interaction
    // manager), mhusika (mchezaji kama mtu), siasa_upinzani
    // (kiongozi wa upinzani wa kisiasa).
    n64 mwingiliano_addr;
    n64 mhusika_addr;
    n64 upinzani_addr;

    // Nyongeza (wimbi la tisa): mashirika (international
    // organizations) -- tafsiri MPYA kabisa, si uunganishaji wa
    // moduli iliyokuwepo tayari (tofauti na mawimbi 7/8) -- angalia
    // maelezo ya wigo juu ya faili.
    n64 mashirika_addr;

    // Nyongeza (wimbi la kumi): vipimo_laini (soft metrics), kitengo_chini
    // (subunits), uandishi (writing systems), historia_db (event journal),
    // soko_fedha (financial markets) -- angalia maelezo ya wigo juu ya
    // faili kuhusu kwa nini hizi tano zilishikiliwa hadi sasa (#295).
    n64 vipimo_laini_addr;
    n64 kitengo_chini_addr;
    n64 uandishi_addr;
    n64 historia_db_addr;
    n64 soko_fedha_addr;

    // Nyongeza (wimbi la kumi na moja, 2026-10-03): mageuko_lugha
    // (culture/language_evolution.c -- TAFSIRI MPYA, si uunganishaji
    // wa moduli iliyokuwepo tayari) na siasa (politics/politics.c --
    // mratibu wa uhalali/utulivu juu ya siasa_kikundi iliyopo TAYARI,
    // angalia maelezo ya siasa.swa kwa nini HAIMILIKI nakala yake
    // mwenyewe ya SiasaKikundiMfumo). utamaduni.swa (culture/culture.c)
    // HAIONGEZI field hapa -- ni kazi za upangiliaji tu juu ya mifumo
    // iliyopo, si mfumo wenye hali yake (angalia maelezo ya
    // utamaduni.swa); kitanzi chake cha "sasisha vitambulisho vyote"
    // kinaitwa moja kwa moja hapa chini kwa kutumia
    // utamaduni_kitambulisho_addr iliyopo TAYARI.
    n64 mageuko_lugha_addr;
    n64 siasa_addr;
};

