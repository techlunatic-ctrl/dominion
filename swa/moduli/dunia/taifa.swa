    TaifaEneo* e0 = dunia_taifa_pata_eneo(t, 0);
    e0->lon_chini = 40.0; e0->lon_juu = 70.0; e0->lat_chini = 25.0; e0->lat_juu = 45.0;
    TaifaEneo* e1 = dunia_taifa_pata_eneo(t, 1);
    e1->lon_chini = 50.0; e1->lon_juu = 75.0; e1->lat_chini = 35.0; e1->lat_juu = 50.0;
    t->idadi_ya_maeneo = 2;
    t->mji_mkuu_lon = 51.0; t->mji_mkuu_lat = 35.0;
    t->idadi_ya_watu = 28000000;
    N32 gr = civ_nasibu_chini_ya(100); D64 gr_d = gr;
    t->gharama_ya_maisha = 0.7 + (gr_d / 200.0);
    N32 zw = civ_nasibu_chini_ya(9500); D64 zw_d = zw;
    t->pato_kwa_kila_mtu = 500.0 + zw_d;

    TaifaMgawanyo* s0 = dunia_taifa_pata_mgawanyo(t, 0);
    s0->jina = "Wilaya Takatifu"; s0->kitambulisho = "takatifu";
    s0->eneo.lon_chini = 40.0; s0->eneo.lon_juu = 55.0; s0->eneo.lat_chini = 30.0; s0->eneo.lat_juu = 45.0;
    TaifaMgawanyo* s1 = dunia_taifa_pata_mgawanyo(t, 1);
    s1->jina = "Hifadhi ya Mashariki"; s1->kitambulisho = "mashariki";
    s1->eneo.lon_chini = 55.0; s1->eneo.lon_juu = 75.0; s1->eneo.lat_chini = 25.0; s1->eneo.lat_juu = 50.0;
    t->idadi_ya_mgawanyo = 2;

    UtawalaSerikali* g = utawala_serikali_unda(t->jina);
    TaifaKatiba* k = taifa_katiba_unda(t->kitambulisho);
