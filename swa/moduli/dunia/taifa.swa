W0 dunia_taifa_mfumo_anzisha_chaguo_msingi(TaifaMfumo* m) {
    kama (m == 0) { rudisha; }
    N32 idadi = 8;
    kama (idadi > m->uwezo) { idadi = m->uwezo; }

    N32 i = 0;
    wakati (i < idadi) {
        TaifaNchi* t = tenga(ukubwa(TaifaNchi));
        t->idadi_ya_maeneo = 0;
        t->idadi_ya_mgawanyo = 0;

        kama (i == 0) { dunia_taifa_kwanza_kifalme(t); }
        sivyo { kama (i == 1) { dunia_taifa_kwanza_kibiashara(t); }
        sivyo { kama (i == 2) { dunia_taifa_kwanza_kidini(t); }
        sivyo { kama (i == 3) { dunia_taifa_kwanza_kidemokrasia(t); }
        sivyo { kama (i == 4) { dunia_taifa_kwanza_kiteknolojia(t); }
        sivyo { kama (i == 5) { dunia_taifa_kwanza_kijeshi(t); }
        sivyo { kama (i == 6) { dunia_taifa_kwanza_kilimo(t); }
        sivyo { dunia_taifa_kwanza_walinzi(t); } } } } } } }

        m->mataifa[i] = t;
        i = i + 1;
    }
    m->idadi = idadi;
    m->faharisi_ya_taifa_la_mchezaji = 3;
}

// ---------- Uanzishaji unaotokana na data (borders + nations_data) ----------

W0 dunia_taifa_mfumo_anzisha_kutoka_data(TaifaMfumo* m, DuniaMataifaData* nd,
                                           DuniaMipakaKisiasa* mipaka) {
    kama (m == 0) { rudisha; }
    N32 idadi_ya_mipaka = 0;
    kama (mipaka != 0) { idadi_ya_mipaka = dunia_mipaka_kisiasa_idadi_ya_mataifa(mipaka); }

    kama (idadi_ya_mipaka > 0 && idadi_ya_mipaka <= m->uwezo) {
        N32 imeundwa = 0;
        N32 cid = 0;
        wakati (cid < idadi_ya_mipaka) {
            N8* jina_la_nchi = dunia_mipaka_kisiasa_jina_la_taifa(mipaka, cid);
            kama (jina_la_nchi == 0) { cid = cid + 1; endelea; }

            N32 rangi = dunia_mipaka_kisiasa_rangi_ya_taifa(mipaka, cid);

            TaifaNchi* t = tenga(ukubwa(TaifaNchi));
            t->kitambulisho = "taifa";
            t->jina = jina_la_nchi;
            t->rangi = rangi;
            t->rangi_pambizo = rangi;
            t->idadi_ya_maeneo = 0;
            t->idadi_ya_mgawanyo = 0;

            DuniaTaifaData* data = 0;
            kama (nd != 0) { data = dunia_mataifa_pata_kwa_jina(nd, jina_la_nchi); }

            kama (data != 0) {
                t->data_id = data->kitambulisho;
                t->iso_a3 = data->iso_a3;
                t->iso_a2 = data->iso_a2;
                t->mji_mkuu_lon = data->mji_mkuu_lon;
                t->mji_mkuu_lat = data->mji_mkuu_lat;
                N32 idadi_ya_watu_n32 = data->idadi_ya_watu_ukadiriaji;
                t->idadi_ya_watu = idadi_ya_watu_n32;

                N32 gdp_m = data->gdp_ukadiriaji_milioni;
                kama (gdp_m > 0 && idadi_ya_watu_n32 > 0) {
                    D64 gdp_d = gdp_m;
                    D64 pop_d = idadi_ya_watu_n32;
                    t->pato_kwa_kila_mtu = gdp_d * 1000000.0 / pop_d;
                } sivyo {
                    N32 zawadi = civ_nasibu_chini_ya(9500);
                    D64 zawadi_d = zawadi;
                    t->pato_kwa_kila_mtu = 500.0 + zawadi_d;
                }

                t->kielezo_cha_teknolojia = 100 + (gdp_m % 500);
                t->kielezo_cha_uchumi = 80 + (gdp_m % 400);
                t->kielezo_cha_kijeshi = 50 + (idadi_ya_watu_n32 % 300);
                t->kielezo_cha_utamaduni = 60 + (idadi_ya_watu_n32 % 350);
            } sivyo {
                N32 nyongeza = civ_nasibu_chini_ya(5000000);
                N64 nyongeza64 = nyongeza;
                t->idadi_ya_watu = 5000000 + nyongeza64;
                N32 zawadi = civ_nasibu_chini_ya(9500);
                D64 zawadi_d = zawadi;
                t->pato_kwa_kila_mtu = 500.0 + zawadi_d;
                t->kielezo_cha_teknolojia = 150;
                t->kielezo_cha_uchumi = 120;
                t->kielezo_cha_kijeshi = 100;
                t->kielezo_cha_utamaduni = 100;
            }

            N32 gharama_r = civ_nasibu_chini_ya(100);
            D64 gharama_r_d = gharama_r;
            t->gharama_ya_maisha = 0.7 + (gharama_r_d / 200.0);

            dunia_taifa_anzisha_serikali_chaguo_msingi(t);
            m->mataifa[imeundwa] = t;
            imeundwa = imeundwa + 1;
            cid = cid + 1;
        }
        m->idadi = imeundwa;
        m->faharisi_ya_taifa_la_mchezaji = 0;
        andika("[TAIFA] Mataifa %d yameundwa kutoka data ya mipaka\n", m->idadi, 0,0,0,0,0);
    } sivyo {
        dunia_taifa_mfumo_anzisha_chaguo_msingi(m);
    }
}

// ---------- Kudai eneo ----------

W0 dunia_taifa_dai_eneo(TaifaNchi* t, DuniaRamani* ramani) {
    kama (t == 0 || ramani == 0) { rudisha; }
    N32 urefu_p1 = ramani->urefu - 1;
    N32 upana_p1 = ramani->upana - 1;
    kama (urefu_p1 < 1) { urefu_p1 = 1; }
    kama (upana_p1 < 1) { upana_p1 = 1; }
    D64 urefu_p1_d = urefu_p1;
    D64 upana_p1_d = upana_p1;

    N32 y = 0;
    wakati (y < ramani->urefu) {
        D64 y_d = y;
        D64 lat = 90.0 - (y_d / urefu_p1_d) * 180.0;

        N32 x = 0;
        wakati (x < ramani->upana) {
            D64 x_d = x;
            D64 lon = (x_d / upana_p1_d) * 360.0 - 180.0;

            N32 r = 0;
            wakati (r < t->idadi_ya_maeneo) {
                TaifaEneo* eneo = dunia_taifa_pata_eneo(t, r);
                kama (dunia_taifa_ndani_ya_eneo(lon, lat, eneo) != 0) {
                    DuniaRamaniKipande* kipande = dunia_ramani_pata_kipande(ramani, x, y);
                    kama (kipande != 0 && kipande->matumizi_ya_ardhi != MAZINGIRA_MATUMIZI_MAJI) {
                        N32 tupu = 1;
                        kama (kipande->mmiliki_id != 0) {
                            N32 urefu_wa_id = urefu_wa_mfuatano(kipande->mmiliki_id);
                            kama (urefu_wa_id > 0) { tupu = 0; }
                        }
                        kama (tupu != 0) {
                            kipande->mmiliki_id = t->kitambulisho;
                            kipande->rangi_ya_kisiasa = t->rangi;
                        }
                    }
                    r = t->idadi_ya_maeneo;
                } sivyo {
                    r = r + 1;
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
}

W0 dunia_taifa_mfumo_dai_maeneo_yote(TaifaMfumo* m, DuniaRamani* ramani) {
    kama (m == 0 || ramani == 0) { rudisha; }
    N32 i = 0;
    wakati (i < m->idadi) {
        TaifaNchi* t = m->mataifa[i];
        dunia_taifa_dai_eneo(t, ramani);
        i = i + 1;
    }
}

W0 dunia_taifa_dai_kutoka_mipaka(TaifaNchi* t, DuniaRamani* ramani,
                                   DuniaMipakaKisiasa* mipaka, N32 faharisi_ya_taifa) {
    kama (t == 0 || ramani == 0 || mipaka == 0) { rudisha; }
    N32 y = 0;
    wakati (y < ramani->urefu) {
        N32 x = 0;
        wakati (x < ramani->upana) {
            N32 cid = dunia_mipaka_kisiasa_taifa_la_kipande(mipaka, x, y);
            kama (cid == faharisi_ya_taifa) {
                DuniaRamaniKipande* kipande = dunia_ramani_pata_kipande(ramani, x, y);
                kama (kipande != 0 && kipande->matumizi_ya_ardhi != MAZINGIRA_MATUMIZI_MAJI) {
                    kipande->mmiliki_id = t->kitambulisho;
                    kipande->rangi_ya_kisiasa = t->rangi;
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
}

// ---------- Rasilimali na uchumi ----------

W0 dunia_taifa_hesabu_rasilimali(TaifaNchi* t, DuniaRamani* ramani,
                                    DuniaRasilimaliRamani* rm, TaifaRasilimaliWasifu* nje) {
    kama (t == 0 || ramani == 0 || nje == 0) { rudisha; }
    nje->jumla = 0;
    nje->idadi_ya_aina = 0;
    nje->mafuta = 0;
    nje->gesi_asilia = 0;
    nje->makaa = 0;

    kama (rm == 0) { rudisha; }

    N32 y = 0;
    wakati (y < ramani->urefu) {
        N32 x = 0;
        wakati (x < ramani->upana) {
            DuniaRamaniKipande* kipande = dunia_ramani_pata_kipande(ramani, x, y);
            kama (kipande == 0 || kipande->matumizi_ya_ardhi == MAZINGIRA_MATUMIZI_MAJI) {
                x = x + 1;
                endelea;
            }
            kama (kipande->mmiliki_id == 0) {
                x = x + 1;
                endelea;
            }
            kama (linganisha_mfuatano(kipande->mmiliki_id, t->kitambulisho) != 0) {
                x = x + 1;
                endelea;
            }

            DuniaRasilimaliAmana* amana_mafuta = dunia_rasilimali_tafuta_kipande(rm, x, y, DUNIA_RASILIMALI_MAFUTA);
            kama (amana_mafuta != 0) {
                nje->mafuta = nje->mafuta + amana_mafuta->kiasi;
                nje->jumla = nje->jumla + amana_mafuta->kiasi;
            }
            DuniaRasilimaliAmana* amana_gesi = dunia_rasilimali_tafuta_kipande(rm, x, y, DUNIA_RASILIMALI_GESI_ASILIA);
            kama (amana_gesi != 0) {
                nje->gesi_asilia = nje->gesi_asilia + amana_gesi->kiasi;
                nje->jumla = nje->jumla + amana_gesi->kiasi;
            }
            DuniaRasilimaliAmana* amana_makaa = dunia_rasilimali_tafuta_kipande(rm, x, y, DUNIA_RASILIMALI_MAKAA);
            kama (amana_makaa != 0) {
                nje->makaa = nje->makaa + amana_makaa->kiasi;
                nje->jumla = nje->jumla + amana_makaa->kiasi;
            }
            x = x + 1;
        }
        y = y + 1;
    }

    nje->idadi_ya_aina = 0;
    kama (nje->mafuta > 0) { nje->idadi_ya_aina = nje->idadi_ya_aina + 1; }
    kama (nje->gesi_asilia > 0) { nje->idadi_ya_aina = nje->idadi_ya_aina + 1; }
    kama (nje->makaa > 0) { nje->idadi_ya_aina = nje->idadi_ya_aina + 1; }
}

TaifaNchi* dunia_taifa_tafuta_kwa_kitambulisho(TaifaMfumo* m, N8* id) {
    kama (m == 0 || id == 0) { rudisha 0; }
    N32 i = 0;
    wakati (i < m->idadi) {
        TaifaNchi* t = m->mataifa[i];
        kama (linganisha_mfuatano(t->kitambulisho, id) == 0) { rudisha t; }
        i = i + 1;
    }
    rudisha 0;
}

TaifaNchi* dunia_taifa_tafuta_kwa_faharisi(TaifaMfumo* m, N32 idx) {
    rudisha dunia_taifa_mfumo_pata_kwa_faharisi(m, idx);
}

N32 dunia_taifa_ina_nukta(TaifaNchi* t, D64 lon, D64 lat) {
    kama (t == 0) { rudisha 0; }
    N32 r = 0;
    wakati (r < t->idadi_ya_maeneo) {
        TaifaEneo* eneo = dunia_taifa_pata_eneo(t, r);
        kama (dunia_taifa_ndani_ya_eneo(lon, lat, eneo) != 0) { rudisha 1; }
        r = r + 1;
    }
    rudisha 0;
}

N32 dunia_taifa_ina_kipande(TaifaNchi* t, N32 tx, N32 ty, DuniaRamani* ramani) {
    kama (t == 0 || ramani == 0) { rudisha 0; }
    N32 upana_p1 = ramani->upana - 1;
    N32 urefu_p1 = ramani->urefu - 1;
    kama (upana_p1 < 1) { upana_p1 = 1; }
    kama (urefu_p1 < 1) { urefu_p1 = 1; }
    D64 tx_d = tx; D64 ty_d = ty;
    D64 upana_p1_d = upana_p1; D64 urefu_p1_d = urefu_p1;
    D64 lon = (tx_d / upana_p1_d) * 360.0 - 180.0;
    D64 lat = 90.0 - (ty_d / urefu_p1_d) * 180.0;
    rudisha dunia_taifa_ina_nukta(t, lon, lat);
}

TaifaNchi* dunia_taifa_tafuta_mmiliki(TaifaMfumo* m, DuniaRamani* ramani, N32 tx, N32 ty) {
    kama (m == 0 || ramani == 0) { rudisha 0; }
    DuniaRamaniKipande* kipande = dunia_ramani_pata_kipande(ramani, tx, ty);
    kama (kipande == 0 || kipande->mmiliki_id == 0) { rudisha 0; }
    N32 urefu_wa_id = urefu_wa_mfuatano(kipande->mmiliki_id);
    kama (urefu_wa_id == 0) { rudisha 0; }
    N32 i = 0;
    wakati (i < m->idadi) {
        TaifaNchi* t = m->mataifa[i];
        kama (linganisha_mfuatano(t->kitambulisho, kipande->mmiliki_id) == 0) { rudisha t; }
        i = i + 1;
    }
    rudisha 0;
}

W0 dunia_taifa_hesabu_uchumi(TaifaNchi* t, DuniaRamani* ramani, DuniaRasilimaliRamani* rm) {
    kama (t == 0 || ramani == 0) { rudisha; }

    t->uchumi.pato_ghafi = 0.0;
    t->uchumi.pato_kwa_kila_mtu = 0.0;
    t->uchumi.ukuaji_wa_pato = 0.0;
    t->uchumi.mfumuko = 0.0;
    t->uchumi.ukosefu_wa_kazi = 0.0;
    t->uchumi.mapato_ya_kodi = 0.0;
    t->uchumi.uzalishaji_wa_chakula = 0.0;
    t->uchumi.matumizi_ya_chakula = 0.0;
    t->uchumi.uzalishaji_wa_nishati = 0.0;
    t->uchumi.uzalishaji_wa_viwanda = 0.0;
    t->uchumi.malighafi = 0.0;
    t->uchumi.nguvukazi = 0.0;
    t->uchumi.mshahara_wa_wastani = 0.0;
    t->uchumi.vipande_vya_ardhi = 0;
    t->uchumi.vipande_vya_maji = 0;

    TaifaRasilimaliWasifu* rp = tenga(ukubwa(TaifaRasilimaliWasifu));
    dunia_taifa_hesabu_rasilimali(t, ramani, rm, rp);

    N32 vipande_vya_ardhi = 0;
    N32 vipande_vya_maji = 0;
    D64 jumla_ya_mwinuko = 0.0;
    D64 jumla_ya_rutuba = 0.0;

    N32 y = 0;
    wakati (y < ramani->urefu) {
        N32 x = 0;
        wakati (x < ramani->upana) {
            DuniaRamaniKipande* kp = dunia_ramani_pata_kipande(ramani, x, y);
            kama (kp == 0) { x = x + 1; endelea; }
            kama (kp->mmiliki_id == 0) { x = x + 1; endelea; }
            kama (linganisha_mfuatano(kp->mmiliki_id, t->kitambulisho) != 0) { x = x + 1; endelea; }

            kama (kp->matumizi_ya_ardhi == MAZINGIRA_MATUMIZI_MAJI) {
                vipande_vya_maji = vipande_vya_maji + 1;
            } sivyo {
                vipande_vya_ardhi = vipande_vya_ardhi + 1;
                jumla_ya_mwinuko = jumla_ya_mwinuko + kp->mwinuko;
                jumla_ya_rutuba = jumla_ya_rutuba + kp->rutuba;
            }
            x = x + 1;
        }
        y = y + 1;
    }

    t->uchumi.vipande_vya_ardhi = vipande_vya_ardhi;
    t->uchumi.vipande_vya_maji = vipande_vya_maji;

    kama (vipande_vya_ardhi == 0) { rudisha; }

    D64 vipande_ardhi_d = vipande_vya_ardhi;
    D64 wastani_wa_mwinuko = jumla_ya_mwinuko / vipande_ardhi_d;
    D64 wastani_wa_rutuba = jumla_ya_rutuba / vipande_ardhi_d;

    D64 idadi_d = t->idadi_ya_watu;
    kama (idadi_d < 1.0) { idadi_d = 1000000.0; }

    N32 tech = t->kielezo_cha_teknolojia;
    N32 econ = t->kielezo_cha_uchumi;
    D64 tech_d = tech; D64 econ_d = econ;
    D64 kipengele_cha_tekno = 1.0 + tech_d * 0.002;
    D64 kipengele_cha_uchumi = 1.0 + econ_d * 0.002;

    D64 pato_msingi = vipande_ardhi_d * 0.5 * kipengele_cha_tekno * kipengele_cha_uchumi;
    D64 jumla_rasilimali_d = rp->jumla;
    D64 zawadi_ya_rasilimali = jumla_rasilimali_d * 0.01;
    D64 pato = pato_msingi + zawadi_ya_rasilimali;
    kama (pato < 1.0) { pato = 1.0; }

    t->uchumi.pato_ghafi = pato;
    t->uchumi.pato_kwa_kila_mtu = pato * 1000000.0 / idadi_d;
    t->uchumi.ukuaji_wa_pato = 0.01 + econ_d * 0.0001;
    t->uchumi.mfumuko = 0.02;
    D64 kigawe = kipengele_cha_uchumi + 0.5;
    t->uchumi.ukosefu_wa_kazi = 0.04 + (1.0 / kigawe) * 0.04;
    t->uchumi.nguvukazi = idadi_d * 0.45;
    t->uchumi.mshahara_wa_wastani = 20000.0 + pato * 0.5;

    t->uchumi.uzalishaji_wa_chakula = vipande_ardhi_d * wastani_wa_rutuba * 500.0 * kipengele_cha_tekno;
    t->uchumi.matumizi_ya_chakula = idadi_d * 2500.0 * 365.0 / 1000000.0;

    D64 rasilimali_nishati_d = rp->mafuta + rp->gesi_asilia + rp->makaa;
    achilia rp;
    t->uchumi.uzalishaji_wa_nishati = vipande_ardhi_d * 0.1 * kipengele_cha_tekno + rasilimali_nishati_d * 0.5;
    kama (t->uchumi.uzalishaji_wa_nishati < 1.0) { t->uchumi.uzalishaji_wa_nishati = 1.0; }

    t->uchumi.malighafi = jumla_rasilimali_d * 10.0 * kipengele_cha_tekno;
    kama (t->uchumi.malighafi < 1.0) { t->uchumi.malighafi = 1.0; }

    t->uchumi.uzalishaji_wa_viwanda = t->uchumi.malighafi * 1.5 * kipengele_cha_uchumi;

    t->uchumi.mapato_ya_kodi = pato * 0.2;
}

W0 dunia_taifa_hesabu_uchumi_wote(TaifaMfumo* m, DuniaRamani* ramani,
                                     DuniaRasilimaliRamani* rm, TaifaUchumi* jumla_nje) {
    kama (m == 0 || ramani == 0) { rudisha; }
    kama (jumla_nje != 0) {
        jumla_nje->pato_ghafi = 0.0; jumla_nje->pato_kwa_kila_mtu = 0.0;
        jumla_nje->ukuaji_wa_pato = 0.0; jumla_nje->mfumuko = 0.0;
        jumla_nje->ukosefu_wa_kazi = 0.0; jumla_nje->mapato_ya_kodi = 0.0;
        jumla_nje->uzalishaji_wa_chakula = 0.0; jumla_nje->matumizi_ya_chakula = 0.0;
        jumla_nje->uzalishaji_wa_nishati = 0.0; jumla_nje->uzalishaji_wa_viwanda = 0.0;
        jumla_nje->malighafi = 0.0; jumla_nje->nguvukazi = 0.0;
        jumla_nje->mshahara_wa_wastani = 0.0; jumla_nje->vipande_vya_ardhi = 0;
        jumla_nje->vipande_vya_maji = 0;
    }

    D64 jumla_ya_pato = 0.0;
    N32 mataifa_yenye_ardhi = 0;

    N32 i = 0;
    wakati (i < m->idadi) {
        TaifaNchi* t = m->mataifa[i];
        dunia_taifa_hesabu_uchumi(t, ramani, rm);
        kama (t->uchumi.vipande_vya_ardhi > 0) {
            jumla_ya_pato = jumla_ya_pato + t->uchumi.pato_ghafi;
            mataifa_yenye_ardhi = mataifa_yenye_ardhi + 1;
        }
        i = i + 1;
    }

    kama (jumla_nje != 0 && mataifa_yenye_ardhi > 0) {
        D64 idadi_d = mataifa_yenye_ardhi;
        jumla_nje->pato_ghafi = jumla_ya_pato;
        jumla_nje->pato_kwa_kila_mtu = jumla_ya_pato / idadi_d;
        jumla_nje->mfumuko = 0.02;
        jumla_nje->ukosefu_wa_kazi = 0.05;
    }
}
