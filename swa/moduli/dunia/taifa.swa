// taifa.swa — tafsiri ya src/core/world/nation.c (na nation.h) kwenda
// Swa. Taifa lenye eneo, muundo wa serikali (kupitia hub ya
// utawala/serikali.swa), mgawanyo wa kiutawala, na uchumi
// unaokokotolewa kutoka eneo linalomilikiwa.
//
// Kiambishi: dunia_taifa_ — angalia ../../KANUNI-MAJINA.md (world/
// -> dunia_).
//
// Ilikuwa imezuiwa kikao kizima kwa sababu mbili, zote sasa
// zimetatuliwa: (1) ilihitaji hub ya serikali inayofanya kazi
// (utawala/serikali.swa, sasa imekamilika), (2) mdudu wa mkusanyaji
// #192 (uharibifu wa kimya wa D64 kwenye faili kubwa) uliozuia
// graph yoyote kubwa ya husisha kufanya kazi sahihi -- sasa
// umerekebishwa (PR #196, imeunganishwa).
//
// Tofauti za kimakusudi kutoka kwa chanzo cha C:
//   - civ_nation_region_t[8] (regions) imekuwa vigezo 8 vyenye
//     majina (eneo_0..eneo_7) + kazi ya kupata (mtindo ulioothibitishwa
//     kikao kizima -- safu za struct zilizopachikwa hazichanganuliwi).
//   - subdivisions[16] (struct isiyo na jina, iliyopachikwa) imekuwa
//     TaifaMgawanyo + vigezo 16 vyenye majina (mgawanyo_0..mgawanyo_15).
//   - government (civ_government_t*) na constitution (void*) ni
//     mifano ya lugha-swa/swa#186 (field ya muundo yenye aina ya
//     kielekezi kwenda muundo mwingine haihifadhi sahihi) -- zimekuwa
//     N64 (anwani) + kazi za kupata/kuweka, mtindo ulioothibitishwa
//     kwenye serikali.swa (fields 14 za aina hii kwenye faili hilo).
//   - civ_nation_manager_t.nations (safu inayokua ya THAMANI za
//     struct, calloc moja kwa moja) imekuwa N64* ya vielekezi kwenda
//     TaifaNchi zilizotengwa kando (mtindo wa dini.swa/kikundi.swa),
//     uwezo umewekwa mara moja kwa DUNIA_TAIFA_UWEZO_JUU (256, sawa
//     na CIV_NATION_CAPACITY_MAX).
//   - civ_nation_resource_profile_t.quantities[20]/best_quality[20]
//     zimepunguzwa kwa makusudi: nation.c YENYEWE inatumia TU jumla
//     ya rasilimali zote (total_resources) na jumla ya mafuta+gesi+
//     makaa (kwa hesabu ya nishati) -- best_quality[] na uwiano wa
//     kila aina havitumiki popote kwenye faili hili. Badala ya safu
//     ya 20, TaifaRasilimaliWasifu ina jumla + idadi_ya_aina +
//     mafuta/gesi_asilia/makaa moja kwa moja, ikiepuka vigezo 40
//     visivyohitajika.
//   - rand() imekuwa civ_nasibu_chini_ya().
//   - snprintf/strcpy za majina/id zimekuwa maandishi ya moja kwa
//     moja (N8* hazihifadhi nakala, kama moduli nyingine zote).

husisha { msingi/msingi_civ.swa }
husisha { msingi/maktaba/mfuatano.swa }
husisha { moduli/utawala/serikali.swa }
husisha { moduli/taifa/katiba.swa }
husisha { moduli/dunia/mataifa_data.swa }
husisha { moduli/dunia/mipaka_kisiasa.swa }
husisha { moduli/dunia/rasilimali.swa }
husisha { moduli/dunia/ramani.swa }

N32 DUNIA_TAIFA_ENEO_IDADI = 8;
N32 DUNIA_TAIFA_MGAWANYO_IDADI = 16;
N32 DUNIA_TAIFA_UWEZO_JUU = 256;

muundo TaifaEneo {
    D64 lon_chini;
    D64 lon_juu;
    D64 lat_chini;
    D64 lat_juu;
};

muundo TaifaMgawanyo {
    N8* jina;
    N8* kitambulisho;
    N32 rangi;
    TaifaEneo eneo;
};

muundo TaifaUchumi {
    D64 pato_ghafi;                 // gdp (millions)
    D64 pato_kwa_kila_mtu;
    D64 ukuaji_wa_pato;
    D64 mfumuko;
    D64 ukosefu_wa_kazi;
    D64 mapato_ya_kodi;
    D64 uzalishaji_wa_chakula;
    D64 matumizi_ya_chakula;
    D64 uzalishaji_wa_nishati;
    D64 uzalishaji_wa_viwanda;
    D64 malighafi;
    D64 nguvukazi;
    D64 mshahara_wa_wastani;
    N32 vipande_vya_ardhi;
    N32 vipande_vya_maji;
};

muundo TaifaRasilimaliWasifu {
    N32 jumla;
    N32 idadi_ya_aina;
    N32 mafuta;
    N32 gesi_asilia;
    N32 makaa;
};

muundo TaifaNchi {
    N8* kitambulisho;
    N8* jina;
    N32 rangi;
    N32 rangi_pambizo;

    N32 data_id;
    N8* iso_a3;
    N8* iso_a2;

    TaifaEneo eneo_0; TaifaEneo eneo_1; TaifaEneo eneo_2; TaifaEneo eneo_3;
    TaifaEneo eneo_4; TaifaEneo eneo_5; TaifaEneo eneo_6; TaifaEneo eneo_7;
    N32 idadi_ya_maeneo;

    D64 mji_mkuu_lon;
    D64 mji_mkuu_lat;

    N64 serikali_addr;    // UtawalaSerikali* (#186)
    N64 katiba_addr;      // TaifaKatiba* (#186)

    TaifaMgawanyo mgawanyo_0; TaifaMgawanyo mgawanyo_1;
    TaifaMgawanyo mgawanyo_2; TaifaMgawanyo mgawanyo_3;
    TaifaMgawanyo mgawanyo_4; TaifaMgawanyo mgawanyo_5;
    TaifaMgawanyo mgawanyo_6; TaifaMgawanyo mgawanyo_7;
    TaifaMgawanyo mgawanyo_8; TaifaMgawanyo mgawanyo_9;
    TaifaMgawanyo mgawanyo_10; TaifaMgawanyo mgawanyo_11;
    TaifaMgawanyo mgawanyo_12; TaifaMgawanyo mgawanyo_13;
    TaifaMgawanyo mgawanyo_14; TaifaMgawanyo mgawanyo_15;
    N32 idadi_ya_mgawanyo;

    TaifaUchumi uchumi;

    N32 kielezo_cha_teknolojia;
    N32 kielezo_cha_uchumi;
    N32 kielezo_cha_kijeshi;
    N32 kielezo_cha_utamaduni;

    N64 idadi_ya_watu;
    D64 gharama_ya_maisha;
    D64 pato_kwa_kila_mtu;
};

muundo TaifaMfumo {
    N64* mataifa;
    N32 idadi;
    N32 uwezo;
    N32 faharisi_ya_taifa_la_mchezaji;
};

// ---------- Vipata (getters) ----------

TaifaEneo* dunia_taifa_pata_eneo(TaifaNchi* t, N32 i) {
    kama (i == 0) { rudisha &t->eneo_0; }
    kama (i == 1) { rudisha &t->eneo_1; }
    kama (i == 2) { rudisha &t->eneo_2; }
    kama (i == 3) { rudisha &t->eneo_3; }
    kama (i == 4) { rudisha &t->eneo_4; }
    kama (i == 5) { rudisha &t->eneo_5; }
    kama (i == 6) { rudisha &t->eneo_6; }
    rudisha &t->eneo_7;
}

TaifaMgawanyo* dunia_taifa_pata_mgawanyo(TaifaNchi* t, N32 i) {
    kama (i == 0) { rudisha &t->mgawanyo_0; }
    kama (i == 1) { rudisha &t->mgawanyo_1; }
    kama (i == 2) { rudisha &t->mgawanyo_2; }
    kama (i == 3) { rudisha &t->mgawanyo_3; }
    kama (i == 4) { rudisha &t->mgawanyo_4; }
    kama (i == 5) { rudisha &t->mgawanyo_5; }
    kama (i == 6) { rudisha &t->mgawanyo_6; }
    kama (i == 7) { rudisha &t->mgawanyo_7; }
    kama (i == 8) { rudisha &t->mgawanyo_8; }
    kama (i == 9) { rudisha &t->mgawanyo_9; }
    kama (i == 10) { rudisha &t->mgawanyo_10; }
    kama (i == 11) { rudisha &t->mgawanyo_11; }
    kama (i == 12) { rudisha &t->mgawanyo_12; }
    kama (i == 13) { rudisha &t->mgawanyo_13; }
    kama (i == 14) { rudisha &t->mgawanyo_14; }
    rudisha &t->mgawanyo_15;
}

UtawalaSerikali* dunia_taifa_pata_serikali(TaifaNchi* t) {
    rudisha t->serikali_addr;
}
W0 dunia_taifa_weka_serikali(TaifaNchi* t, UtawalaSerikali* v) {
    t->serikali_addr = v;
}

TaifaKatiba* dunia_taifa_pata_katiba(TaifaNchi* t) {
    rudisha t->katiba_addr;
}
W0 dunia_taifa_weka_katiba(TaifaNchi* t, TaifaKatiba* v) {
    t->katiba_addr = v;
}

TaifaNchi* dunia_taifa_mfumo_pata_kwa_faharisi(TaifaMfumo* m, N32 idx) {
    kama (idx < 0 || idx >= m->idadi) { rudisha 0; }
    rudisha m->mataifa[idx];
}

// ---------- Msaidizi: nukta iko ndani ya eneo ----------

N32 dunia_taifa_ndani_ya_eneo(D64 lon, D64 lat, TaifaEneo* e) {
    kama (lon >= e->lon_chini && lon <= e->lon_juu
        && lat >= e->lat_chini && lat <= e->lat_juu) {
        rudisha 1;
    }
    rudisha 0;
}

// ---------- Maisha ya mfumo ----------

TaifaMfumo* dunia_taifa_mfumo_unda() {
    TaifaMfumo* m = tenga(ukubwa(TaifaMfumo));
    m->uwezo = DUNIA_TAIFA_UWEZO_JUU;
    m->mataifa = tenga(ukubwa(N64) * m->uwezo);
    m->idadi = 0;
    m->faharisi_ya_taifa_la_mchezaji = 0;
    rudisha m;
}

W0 dunia_taifa_mfumo_uharibu(TaifaMfumo* m) {
    kama (m == 0) { rudisha; }
    N32 i = 0;
    wakati (i < m->idadi) {
        TaifaNchi* t = m->mataifa[i];
        UtawalaSerikali* g = dunia_taifa_pata_serikali(t);
        kama (g != 0) { utawala_serikali_uharibu(g); }
        TaifaKatiba* k = dunia_taifa_pata_katiba(t);
        kama (k != 0) { taifa_katiba_uharibu(k); }
        achilia t;
        i = i + 1;
    }
    achilia m->mataifa;
    achilia m;
}

// ---------- Serikali chaguo-msingi (data-driven) ----------

W0 dunia_taifa_anzisha_serikali_chaguo_msingi(TaifaNchi* t) {
    UtawalaSerikali* g = utawala_serikali_unda(t->jina);
    TaifaKatiba* k = taifa_katiba_unda(t->kitambulisho);
    dunia_taifa_weka_serikali(t, g);
    dunia_taifa_weka_katiba(t, k);

    UtawalaNafasiUzito* uz1 = tenga(ukubwa(UtawalaNafasiUzito));
    uz1->uzito_wa_utendaji = 0.35; uz1->uzito_wa_kibunge = 0.25; uz1->uzito_wa_kimahakama = 0.10;
    utawala_serikali_ongeza_nafasi(g, "Mkuu wa Nchi", 0, uz1, "hutofautiana", "hutofautiana", 1);
    achilia uz1;

    UtawalaNafasiUzito* uz2 = tenga(ukubwa(UtawalaNafasiUzito));
    uz2->uzito_wa_utendaji = 0.10; uz2->uzito_wa_kibunge = 0.60; uz2->uzito_wa_kimahakama = 0.05;
    utawala_serikali_ongeza_nafasi(g, "Baraza la Mawaziri", 1, uz2, "uteuzi", "bila_kikomo", 15);
    achilia uz2;

    UtawalaNafasiUzito* uz3 = tenga(ukubwa(UtawalaNafasiUzito));
    uz3->uzito_wa_utendaji = 0.10; uz3->uzito_wa_kibunge = 0.55; uz3->uzito_wa_kimahakama = 0.05;
    utawala_serikali_ongeza_nafasi(g, "Bunge", 1, uz3, "uchaguzi", "miaka_4", 100);
    achilia uz3;

    UtawalaNafasiUzito* uz4 = tenga(ukubwa(UtawalaNafasiUzito));
    uz4->uzito_wa_utendaji = 0.05; uz4->uzito_wa_kibunge = 0.05; uz4->uzito_wa_kimahakama = 0.65;
    utawala_serikali_ongeza_nafasi(g, "Mahakama Kuu", 1, uz4, "uteuzi", "maisha", 7);
    achilia uz4;

    UtawalaNafasiUzito* uz5 = tenga(ukubwa(UtawalaNafasiUzito));
    uz5->uzito_wa_utendaji = 0.15; uz5->uzito_wa_kibunge = 0.15; uz5->uzito_wa_kimahakama = 0.05;
    utawala_serikali_ongeza_nafasi(g, "Magavana wa Mikoa", 2, uz5, "hutofautiana", "hutofautiana", 10);
    achilia uz5;

    utawala_serikali_hesabu_wasifu(g);
}

// ---------- Mataifa 8 yaliyowekwa awali (procedural fallback) ----------

W0 dunia_taifa_kwanza_kifalme(TaifaNchi* t) {
    t->kitambulisho = "utawala_wa_kifalme";
    t->jina = "Utawala wa Kifalme";
    t->rangi = 13382656; t->rangi_pambizo = 16755780;
    t->kielezo_cha_teknolojia = 280; t->kielezo_cha_uchumi = 320;
    t->kielezo_cha_kijeshi = 340; t->kielezo_cha_utamaduni = 220;
    TaifaEneo* e0 = dunia_taifa_pata_eneo(t, 0);
    e0->lon_chini = 0.0 - 10.0; e0->lon_juu = 60.0; e0->lat_chini = 35.0; e0->lat_juu = 72.0;
    TaifaEneo* e1 = dunia_taifa_pata_eneo(t, 1);
    e1->lon_chini = 0.0 - 10.0; e1->lon_juu = 40.0; e1->lat_chini = 25.0; e1->lat_juu = 55.0;
    t->idadi_ya_maeneo = 2;
    t->mji_mkuu_lon = 12.0; t->mji_mkuu_lat = 52.0;
    t->idadi_ya_watu = 45000000;
    N32 gr = civ_nasibu_chini_ya(100); D64 gr_d = gr;
    t->gharama_ya_maisha = 0.7 + (gr_d / 200.0);
    N32 zw = civ_nasibu_chini_ya(9500); D64 zw_d = zw;
    t->pato_kwa_kila_mtu = 500.0 + zw_d;

    TaifaMgawanyo* s0 = dunia_taifa_pata_mgawanyo(t, 0);
    s0->jina = "Mkoa wa Kaskazini"; s0->kitambulisho = "kaskazini";
    s0->eneo.lon_chini = 0.0 - 10.0; s0->eneo.lon_juu = 40.0; s0->eneo.lat_chini = 55.0; s0->eneo.lat_juu = 72.0;
    TaifaMgawanyo* s1 = dunia_taifa_pata_mgawanyo(t, 1);
    s1->jina = "Mkoa wa Kusini"; s1->kitambulisho = "kusini";
    s1->eneo.lon_chini = 0.0 - 10.0; s1->eneo.lon_juu = 40.0; s1->eneo.lat_chini = 25.0; s1->eneo.lat_juu = 55.0;
    t->idadi_ya_mgawanyo = 2;

    UtawalaSerikali* g = utawala_serikali_unda(t->jina);
    TaifaKatiba* k = taifa_katiba_unda(t->kitambulisho);
    dunia_taifa_weka_serikali(t, g);
    dunia_taifa_weka_katiba(t, k);
    UtawalaNafasiUzito* u1 = tenga(ukubwa(UtawalaNafasiUzito));
    u1->uzito_wa_utendaji = 0.80; u1->uzito_wa_kibunge = 0.10; u1->uzito_wa_kimahakama = 0.10;
    utawala_serikali_ongeza_nafasi(g, "Kansela Mkuu", 0, u1, "uteuzi", "maisha", 1);
    achilia u1;
    UtawalaNafasiUzito* u2 = tenga(ukubwa(UtawalaNafasiUzito));
    u2->uzito_wa_utendaji = 0.15; u2->uzito_wa_kibunge = 0.60; u2->uzito_wa_kimahakama = 0.05;
    utawala_serikali_ongeza_nafasi(g, "Baraza la Mawaziri", 1, u2, "uteuzi_kutoka_juu", "bila_kikomo", 15);
    achilia u2;
    UtawalaNafasiUzito* u3 = tenga(ukubwa(UtawalaNafasiUzito));
    u3->uzito_wa_utendaji = 0.05; u3->uzito_wa_kibunge = 0.05; u3->uzito_wa_kimahakama = 0.70;
    utawala_serikali_ongeza_nafasi(g, "Baraza Kuu la Sheria", 1, u3, "uteuzi", "maisha", 7);
    achilia u3;
    utawala_serikali_hesabu_wasifu(g);
}

